# Copy to .env. Only needed for the "Connect GitHub" button.
# Create an OAuth app at https://github.com/settings/developers with the
# callback URL  http://localhost:5173/api/github/callback  (dev)
# or            https://your-domain/api/github/callback    (hosted)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Server settings (defaults shown)
# PORT=8787
# HOST=127.0.0.1
# PUBLIC_URL=                 # set when the server sits behind a proxy with a different public address
# ALLOWED_ORIGINS=            # comma-separated extra frontend origins, e.g. https://algodesk.vercel.app
